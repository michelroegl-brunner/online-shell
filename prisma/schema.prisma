// Online-Shell — see docs/SKETCH.md for the design.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ShellKind {
  BASH
  PWSH
}

enum Visibility {
  PRIVATE
  SHARED
}

enum AssignmentMode {
  PRACTICE
  EXAM
}

/// EXERCISE = graded task. LESSON = guided, ungraded walkthrough (steps
/// explain a concept and check themselves after each command).
enum ExerciseKind {
  EXERCISE
  LESSON
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}

// ────────────────────────────────────────────────────────────
// Users & classes (Entra = source of truth)
// ────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  /// Entra object id (`oid` claim). Dev-login users get "dev:<email>".
  entraOid    String    @unique
  email       String    @unique
  name        String
  /// Recomputed from Entra App Roles on every sign-in.
  role        Role      @default(STUDENT)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships          ClassMembership[]
  teachingClasses      ClassTeacher[]
  authoredExercises    Exercise[]
  cheatSheets          CheatSheet[]
  attempts             Attempt[]
  assignmentExtensions AssignmentExtension[]
  classGroups          ClassGroupMember[]
  announcements        Announcement[]
  submissions          AssignmentSubmission[]
  gradePushes          GradePush[]
  /// Personal practice sets (Assignment.practiceForId)
  practiceSets         Assignment[]           @relation("PracticeSets")
  assignmentTemplates  AssignmentTemplate[]
}

model Class {
  id           String   @id @default(cuid())
  /// M365 group id
  entraGroupId String   @unique
  name         String
  schoolYear   String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships ClassMembership[]
  teachers    ClassTeacher[]
  assignments Assignment[]
  groups      ClassGroup[]
}

/// A split of a class, e.g. "Gruppe A" / "Gruppe B" for lab lessons.
/// A student may be in several groups of the same class.
model ClassGroup {
  id             String   @id @default(cuid())
  classId        String
  name           String
  /// Set when the group mirrors a Wechselplan group:
  /// "<planClassId>:<weekday>:<groupId>". Re-pulling updates it in place.
  wechselplanKey String?
  createdAt      DateTime @default(now())

  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  members     ClassGroupMember[]
  assignments AssignmentGroup[]

  @@unique([classId, name])
  @@unique([classId, wechselplanKey])
}

model ClassGroupMember {
  groupId String
  userId  String

  group ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model ClassMembership {
  userId   String
  classId  String
  syncedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
}

model ClassTeacher {
  classId String
  userId  String

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// Exercises
// ────────────────────────────────────────────────────────────

model Exercise {
  id            String       @id @default(cuid())
  /// Folder name inside the student's home: ~/exercises/<slug>
  slug          String       @unique
  title         String
  /// Markdown intro shown above the steps
  description   String
  shell         ShellKind
  kind          ExerciseKind @default(EXERCISE)
  difficulty    Int          @default(1)
  /// Total of all step points (kept in sync when the steps are saved)
  points        Int          @default(10)
  /// Runs once for the whole exercise; all steps share the folder
  setupScript   String       @default("")
  /// Setup runs in a helper container with internet access (downloads)
  setupInternet Boolean      @default(false)
  tags          String[]
  /// Per-student values (src/lib/variables.ts): `{{NAME}}` in texts and
  /// ready-made checks, `$NAME` in setup/check scripts.
  variables     Json         @default("[]")
  visibility    Visibility   @default(PRIVATE)
  archived      Boolean      @default(false)
  authorId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  author          User                     @relation(fields: [authorId], references: [id])
  steps           ExerciseStep[]
  assignmentItems AssignmentItem[]
  templateItems   AssignmentTemplateItem[]

  @@index([authorId])
}

/// One task inside an exercise ("chained" exercises have several).
model ExerciseStep {
  id               String   @id @default(cuid())
  exerciseId       String
  order            Int
  title            String
  /// Markdown
  description      String   @default("")
  checkScript      String   @default("")
  /// Ready-made checks (see src/lib/checks.ts); all must pass, plus the
  /// check script if it isn't empty.
  checks           Json     @default("[]")
  hints            String[]
  points           Int      @default(10)
  /// Locked until the previous step is solved (set by the author per step)
  requiresPrevious Boolean  @default(true)
  /// The student's box is online while this is their current step
  allowInternet    Boolean  @default(false)

  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  attemptSteps AttemptStep[]

  @@index([exerciseId, order])
}

// ────────────────────────────────────────────────────────────
// Assignments (practice sets and exams given to a class)
// ────────────────────────────────────────────────────────────

model Assignment {
  id              String         @id @default(cuid())
  title           String
  classId         String
  mode            AssignmentMode @default(PRACTICE)
  opensAt         DateTime?
  dueAt           DateTime?
  /// null = unlimited (practice)
  maxChecks       Int?
  /// Topic cheat sheets are shown next to the terminal
  allowCheatSheet Boolean        @default(true)
  allowHints      Boolean        @default(true)
  /// Each revealed hint costs this % of the step's points (0 = free).
  hintPenalty     Int            @default(0)
  allowPaste      Boolean        @default(true)
  published       Boolean        @default(false)
  /// Draft that becomes visible to students at this time (scheduled publish).
  publishAt       DateTime?
  /// Personal practice set of one student ("practise your weak spots").
  /// Only that student sees it; teachers' lists and reports leave it out.
  practiceForId   String?
  /// The tag the practice set was made for.
  practiceTag     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  class         Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  practiceFor   User?                  @relation("PracticeSets", fields: [practiceForId], references: [id], onDelete: Cascade)
  items         AssignmentItem[]
  extensions    AssignmentExtension[]
  /// No groups = whole class; otherwise only students in >= 1 of them.
  groups        AssignmentGroup[]
  announcements Announcement[]
  submissions   AssignmentSubmission[]
  gradePushes   GradePush[]

  @@index([classId])
  @@index([practiceForId])
}

model AssignmentGroup {
  assignmentId String
  groupId      String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group      ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([assignmentId, groupId])
  @@index([groupId])
}

model AssignmentItem {
  id           String  @id @default(cuid())
  assignmentId String
  exerciseId   String
  order        Int
  /// Overrides Exercise.points when set
  points       Int?
  /// The items after this one stay locked until this one is solved
  /// (e.g. a lesson that has to be done before the exercises).
  gate         Boolean @default(false)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
  attempts   Attempt[]

  @@unique([assignmentId, exerciseId])
  @@index([exerciseId])
}

/// Reusable assignment: exercises + settings, no class or dates. "Use" it to
/// create a real assignment for a class/groups with a time window.
model AssignmentTemplate {
  id              String         @id @default(cuid())
  title           String
  /// Private note for teachers (not shown to students)
  description     String         @default("")
  mode            AssignmentMode @default(PRACTICE)
  maxChecks       Int?
  allowHints      Boolean        @default(true)
  /// Each revealed hint costs this % of the step's points (0 = free).
  hintPenalty     Int            @default(0)
  allowCheatSheet Boolean        @default(true)
  allowPaste      Boolean        @default(false)
  /// Suggested length; "Due" is filled in as opens + duration when used.
  durationMinutes Int?
  /// SHARED = other teachers can use (and copy) it.
  visibility      Visibility     @default(PRIVATE)
  ownerId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items AssignmentTemplateItem[]

  @@index([ownerId])
}

model AssignmentTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  exerciseId String
  order      Int
  /// null = exercise default
  points     Int?
  /// The items after this one stay locked until this one is solved
  gate       Boolean @default(false)

  template AssignmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([templateId, exerciseId])
  @@index([exerciseId])
}

model AssignmentExtension {
  assignmentId String
  userId       String
  extraMinutes Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
}

/// Exam mode: the student handed in; the assignment is closed for them
/// until a teacher reopens it (deletes this row).
model AssignmentSubmission {
  assignmentId String
  userId       String
  submittedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@index([userId])
}

/// Message from a teacher to everyone working on an assignment.
model Announcement {
  id           String   @id @default(cuid())
  assignmentId String
  authorId     String
  text         String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Attempts, command log, exam events
// ────────────────────────────────────────────────────────────

model Attempt {
  id               String        @id @default(cuid())
  userId           String
  assignmentItemId String
  status           AttemptStatus @default(IN_PROGRESS)
  /// Runner box the attempt ran in (box = container)
  boxId            String?
  score            Int?
  checks           Int           @default(0)
  hintsUsed        Int           @default(0)
  checkOutput      String?
  startedAt        DateTime      @default(now())
  /// Last time the setup script ran (null = folder not prepared yet)
  setupAt          DateTime?
  /// How often the student reset the exercise folder
  resets           Int           @default(0)
  /// Extra checks per step granted by a teacher (on top of maxChecks)
  extraChecks      Int           @default(0)
  /// Teacher's manual score; replaces the computed score while set
  scoreOverride    Int?
  /// Teacher's note to the student (shown on the exercise page)
  feedback         String?
  feedbackAt       DateTime?
  /// This student's values for the exercise's variables (name -> value)
  vars             Json?
  finishedAt       DateTime?
  updatedAt        DateTime      @default(now()) @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentItem AssignmentItem @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)
  commands       CommandLog[]
  events         ExamEvent[]
  /// Checks, hints, resets… (session replay, heatmap)
  activity       AttemptEvent[]
  /// Per-step progress; status/score/checks/hintsUsed above are the totals.
  steps          AttemptStep[]

  /// One attempt per student and assignment exercise; retries update it.
  @@unique([userId, assignmentItemId])
  @@index([assignmentItemId])
}

/// Progress of one attempt on one step.
model AttemptStep {
  attemptId   String
  stepId      String
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?
  checks      Int           @default(0)
  hintsUsed   Int           @default(0)
  /// Hints revealed when the step passed (what the hint penalty counts)
  hintsAtPass Int?
  checkOutput String?
  passedAt    DateTime?
  updatedAt   DateTime      @default(now()) @updatedAt

  attempt Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  step    ExerciseStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([attemptId, stepId])
  @@index([stepId])
}

/// Short reference for a topic, shown beside the terminal on exercises
/// that share one of its tags.
model CheatSheet {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  shell      ShellKind
  /// Shown on exercises/lessons that have at least one of these tags
  tags       String[]
  /// Markdown
  body       String     @default("")
  /// Lower first
  order      Int        @default(0)
  visibility Visibility @default(SHARED)
  archived   Boolean    @default(false)
  authorId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model CommandLog {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  at        DateTime @default(now())
  command   String
  exitCode  Int?
  cwd       String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}

/// What happened on an attempt besides commands: checks (passed or not),
/// hints, resets, the setup. Feeds the session replay and the heatmap.
model AttemptEvent {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  at        DateTime @default(now())
  /// SETUP | CHECK | AUTOCHECK | HINT | RESET | SUBMIT
  type      String
  stepId    String?
  ok        Boolean?
  /// CHECK: first lines of the check output; HINT: hint number
  detail    String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
  @@index([stepId, type])
}

model ExamEvent {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  at        DateTime @default(now())
  /// BLUR | HIDDEN | FULLSCREEN_EXIT | PASTE (detail: JSON)
  type      String
  detail    String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}

/// Grades of an assignment sent to Wechselplan's Noten grid (one row per push).
model GradePush {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  /// NotenEntry column, e.g. "praktischeArbeit1"
  field        String
  /// Entries sent / actually written
  sent         Int
  written      Int
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}
