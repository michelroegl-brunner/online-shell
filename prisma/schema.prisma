// Online-Shell — see docs/SKETCH.md for the design.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ShellKind {
  BASH
  PWSH
}

enum Visibility {
  PRIVATE
  SHARED
}

enum AssignmentMode {
  PRACTICE
  EXAM
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}

// ────────────────────────────────────────────────────────────
// Users & classes (Entra = source of truth)
// ────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  /// Entra object id (`oid` claim). Dev-login users get "dev:<email>".
  entraOid    String    @unique
  email       String    @unique
  name        String
  /// Recomputed from Entra App Roles on every sign-in.
  role        Role      @default(STUDENT)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships          ClassMembership[]
  teachingClasses      ClassTeacher[]
  authoredExercises    Exercise[]
  attempts             Attempt[]
  assignmentExtensions AssignmentExtension[]
  classGroups          ClassGroupMember[]
  announcements        Announcement[]
  submissions          AssignmentSubmission[]
}

model Class {
  id           String   @id @default(cuid())
  /// M365 group id
  entraGroupId String   @unique
  name         String
  schoolYear   String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships ClassMembership[]
  teachers    ClassTeacher[]
  assignments Assignment[]
  groups      ClassGroup[]
}

/// A split of a class, e.g. "Gruppe A" / "Gruppe B" for lab lessons.
/// A student may be in several groups of the same class.
model ClassGroup {
  id        String   @id @default(cuid())
  classId   String
  name      String
  createdAt DateTime @default(now())

  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  members     ClassGroupMember[]
  assignments AssignmentGroup[]

  @@unique([classId, name])
}

model ClassGroupMember {
  groupId String
  userId  String

  group ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model ClassMembership {
  userId   String
  classId  String
  syncedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
}

model ClassTeacher {
  classId String
  userId  String

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────
// Exercises
// ────────────────────────────────────────────────────────────

model Exercise {
  id          String     @id @default(cuid())
  /// Folder name inside the student's home: ~/exercises/<slug>
  slug        String     @unique
  title       String
  /// Markdown intro shown above the steps
  description String
  shell       ShellKind
  difficulty  Int        @default(1)
  /// Total of all step points (kept in sync when the steps are saved)
  points      Int        @default(10)
  /// Runs once for the whole exercise; all steps share the folder
  setupScript String     @default("")
  tags        String[]
  visibility  Visibility @default(PRIVATE)
  archived    Boolean    @default(false)
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author          User             @relation(fields: [authorId], references: [id])
  steps           ExerciseStep[]
  assignmentItems AssignmentItem[]

  @@index([authorId])
}

/// One task inside an exercise ("chained" exercises have several).
model ExerciseStep {
  id               String   @id @default(cuid())
  exerciseId       String
  order            Int
  title            String
  /// Markdown
  description      String   @default("")
  checkScript      String   @default("")
  hints            String[]
  points           Int      @default(10)
  /// Locked until the previous step is solved (set by the author per step)
  requiresPrevious Boolean  @default(true)

  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  attemptSteps AttemptStep[]

  @@index([exerciseId, order])
}

// ────────────────────────────────────────────────────────────
// Assignments (practice sets and exams given to a class)
// ────────────────────────────────────────────────────────────

model Assignment {
  id         String         @id @default(cuid())
  title      String
  classId    String
  mode       AssignmentMode @default(PRACTICE)
  opensAt    DateTime?
  dueAt      DateTime?
  /// null = unlimited (practice)
  maxChecks  Int?
  allowHints Boolean        @default(true)
  allowPaste Boolean        @default(true)
  published  Boolean        @default(false)
  /// Draft that becomes visible to students at this time (scheduled publish).
  publishAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  class         Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  items         AssignmentItem[]
  extensions    AssignmentExtension[]
  /// No groups = whole class; otherwise only students in >= 1 of them.
  groups        AssignmentGroup[]
  announcements Announcement[]
  submissions   AssignmentSubmission[]

  @@index([classId])
}

model AssignmentGroup {
  assignmentId String
  groupId      String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group      ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([assignmentId, groupId])
  @@index([groupId])
}

model AssignmentItem {
  id           String @id @default(cuid())
  assignmentId String
  exerciseId   String
  order        Int
  /// Overrides Exercise.points when set
  points       Int?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
  attempts   Attempt[]

  @@unique([assignmentId, exerciseId])
  @@index([exerciseId])
}

model AssignmentExtension {
  assignmentId String
  userId       String
  extraMinutes Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
}

/// Exam mode: the student handed in; the assignment is closed for them
/// until a teacher reopens it (deletes this row).
model AssignmentSubmission {
  assignmentId String
  userId       String
  submittedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@index([userId])
}

/// Message from a teacher to everyone working on an assignment.
model Announcement {
  id           String   @id @default(cuid())
  assignmentId String
  authorId     String
  text         String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Attempts, command log, exam events
// ────────────────────────────────────────────────────────────

model Attempt {
  id               String        @id @default(cuid())
  userId           String
  assignmentItemId String
  status           AttemptStatus @default(IN_PROGRESS)
  /// Runner box the attempt ran in (box = container)
  boxId            String?
  score            Int?
  checks           Int           @default(0)
  hintsUsed        Int           @default(0)
  checkOutput      String?
  startedAt        DateTime      @default(now())
  /// Last time the setup script ran (null = folder not prepared yet)
  setupAt          DateTime?
  /// How often the student reset the exercise folder
  resets           Int           @default(0)
  /// Extra checks per step granted by a teacher (on top of maxChecks)
  extraChecks      Int           @default(0)
  /// Teacher's manual score; replaces the computed score while set
  scoreOverride    Int?
  /// Teacher's note to the student (shown on the exercise page)
  feedback         String?
  feedbackAt       DateTime?
  finishedAt       DateTime?
  updatedAt        DateTime      @default(now()) @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentItem AssignmentItem @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)
  commands       CommandLog[]
  events         ExamEvent[]
  /// Per-step progress; status/score/checks/hintsUsed above are the totals.
  steps          AttemptStep[]

  /// One attempt per student and assignment exercise; retries update it.
  @@unique([userId, assignmentItemId])
  @@index([assignmentItemId])
}

/// Progress of one attempt on one step.
model AttemptStep {
  attemptId   String
  stepId      String
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?
  checks      Int           @default(0)
  hintsUsed   Int           @default(0)
  checkOutput String?
  passedAt    DateTime?
  updatedAt   DateTime      @default(now()) @updatedAt

  attempt Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  step    ExerciseStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([attemptId, stepId])
  @@index([stepId])
}

model CommandLog {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  at        DateTime @default(now())
  command   String
  exitCode  Int?
  cwd       String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}

model ExamEvent {
  id        BigInt   @id @default(autoincrement())
  attemptId String
  at        DateTime @default(now())
  /// BLUR | HIDDEN | FULLSCREEN_EXIT | PASTE (detail: JSON)
  type      String
  detail    String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}
