{
	# The public certificate lives on the school's edge proxy
	# (htlsrv-proxy-caddy, 10.10.10.250). It forwards to
	#   https://10.10.10.230:443  (tls_insecure_skip_verify)
	# so this Caddy only needs a self-signed internal certificate. The edge
	# connects by IP (no SNI), hence default_sni.
	default_sni {$DOMAIN}
	servers {
		# Trust X-Forwarded-* (proto=https, client IP) from the edge proxy.
		trusted_proxies static private_ranges
	}
}

(app) {
	encode zstd gzip

	# Terminal WebSockets go straight to the runner; everything else to Next.
	@attach path /attach /attach/*
	reverse_proxy @attach runner:4100

	reverse_proxy web:3000
}

https://{$DOMAIN}, https://10.10.10.230 {
	tls internal
	import app
}

# Plain HTTP as well (e.g. if the edge proxy is switched to http://…:80).
http://:80 {
	import app
}
