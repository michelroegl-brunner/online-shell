{
	# The public certificate lives on the school's edge proxy
	# (htlsrv-proxy-caddy, 10.10.10.250). It forwards to
	#   https://10.10.10.230:443  (tls_insecure_skip_verify)
	# so this Caddy only needs a self-signed internal certificate. The edge
	# connects by IP (no SNI), hence default_sni.
	default_sni {$DOMAIN}
	# HTTPS only; no plain-HTTP listener.
	auto_https disable_redirects
	servers {
		# Trust X-Forwarded-* (proto, client IP) ONLY from the edge proxy.
		trusted_proxies static 10.10.10.250/32
	}
}

https://{$DOMAIN}, https://10.10.10.230 {
	tls internal
	encode zstd gzip

	# Runner -> web callbacks are internal (docker network only).
	respond /api/runner/* 404

	# Terminal WebSockets (students' /attach, teachers' /watch) go straight to
	# the runner; everything else to Next.
	@attach path /attach /attach/* /watch /watch/*
	reverse_proxy @attach runner:4100

	reverse_proxy web:3000
}
