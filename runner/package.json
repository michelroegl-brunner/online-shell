{
  "name": "@online-shell/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "image:bash": "docker build -t oshell-bash:latest images/bash"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "jose": "^6.2.17",
    "ws": "^8.22.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
