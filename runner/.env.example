# Shared with the web app (RUNNER_SECRET there). Generate: openssl rand -base64 32
RUNNER_SECRET=""
PORT=4100
# Browser origins allowed to open terminal WebSockets (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"
BASH_IMAGE="oshell-bash:latest"
# Destroy a box after this many minutes without input (home volume is kept)
IDLE_MINUTES=15
# Hard upper bound for a box's lifetime
MAX_LIFETIME_MINUTES=120
