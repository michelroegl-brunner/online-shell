# Postgres (see docker-compose.dev.yml)
DATABASE_URL="postgresql://oshell:oshell@localhost:5434/oshell"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Microsoft Entra ID app registration (single tenant)
# Redirect URI: {APP_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# Dev-only login (pick a role without Entra). Ignored in production.
AUTH_DEV_LOGIN="true"
